    <!-- About -->
    <string name="version">Version %1$s</string>
    <string name="about_intro">OnTime keeps speakers on schedule. Set a total time and two warning
        points, and the whole screen turns yellow, then red, so a glance is enough. When the time
        runs out the clock keeps counting so you know exactly how far over you ran.</string>
    <string name="about_features_title">Features</string>
    <string name="about_feature_thresholds">Total time with yellow and red warnings, each set to the time remaining.</string>
    <string name="about_feature_colors">The background changes sharply between green, yellow and red.</string>
    <string name="about_feature_overtime">The overtime clock keeps running past zero.</string>
    <string name="about_feature_presets">Save as many timers as you need and switch between them from the Timers list.</string>
    <string name="about_feature_fullscreen">Turn the phone sideways and tap the clock for a full-screen view with nothing on it but the time.</string>
    <string name="about_feature_awake">The screen stays on while a timer is on screen.</string>
    <string name="about_feature_rotation">Rotating the device never disturbs a running timer.</string>
